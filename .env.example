# Site
NEXT_PUBLIC_SITE_URL=https://bible-rank.com

# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_. Bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Developers -> API keys / Webhooks
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Embeddings (OpenAI) — used for semantic search
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Admin (/admin) — HTTP Basic Auth
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Cron — authorizes /api/cron/resolve (Vercel Cron sends this automatically
# once CRON_SECRET is set as a Vercel env var; also used by the /admin
# "Resolve now" manual trigger). Generate a random value.
CRON_SECRET=
